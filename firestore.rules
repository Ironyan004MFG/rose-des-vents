rules_version = '2';

// Grande Guilde de la Rose des Vents - règles Firestore
// - Tout le monde peut lire les comptoirs, les quêtes et les inscriptions.
// - Seuls les comptes listés dans /admins peuvent modifier les quêtes et gérer les inscriptions.
// - Un joueur (connexion anonyme) peut créer UNE demande par quête, à son nom, et retirer la sienne.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function str(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }
    function optStr(d, k, maxLen) {
      return !(k in d) || str(d[k], 0, maxLen);
    }
    function realAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function optCount(d, k) {
      return !(k in d) || d[k] == null || (d[k] is int && d[k] >= 0 && d[k] <= 99);
    }

    // ---------- Administrateurs (gérés seulement depuis la console Firebase) ----------
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---------- Comptoirs ----------
    match /bureaux/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['nom', 'x', 'y', 'siege', 'ordre'])
        && str(request.resource.data.nom, 1, 60)
        && request.resource.data.x is number && request.resource.data.y is number;
    }

    // ---------- Quêtes ----------
    function validQuest(d) {
      return d.keys().hasOnly(['bureau', 'titre', 'type', 'rang', 'statut', 'lieu', 'recompense', 'niveau',
                               'joueurs', 'joueursMin', 'joueursMax', 'supercharged', 'date', 'description',
                               'pointsRenommee', 'rapport', 'redacteur', 'rapportBrouillon', 'maj', 'creeLe', 'majLe'])
        && d.keys().hasAll(['bureau', 'titre', 'rang', 'statut'])
        && exists(/databases/$(database)/documents/bureaux/$(d.bureau))
        && str(d.titre, 1, 120)
        && d.rang in ['cuivre', 'fer', 'argent', 'or', 'mithral', 'inconnu']
        && d.statut in ['ouverte', 'encours', 'terminee', 'archivee']
        && optStr(d, 'type', 40) && optStr(d, 'lieu', 200) && optStr(d, 'recompense', 200)
        && optStr(d, 'niveau', 40) && optStr(d, 'joueurs', 40) && optStr(d, 'date', 80)
        && optStr(d, 'description', 4000) && optStr(d, 'maj', 1000)
        && optCount(d, 'joueursMin') && optCount(d, 'joueursMax')
        && (!('supercharged' in d) || d.supercharged is bool)
        && (!('pointsRenommee' in d) || d.pointsRenommee == null || (d.pointsRenommee is int && d.pointsRenommee >= -1000 && d.pointsRenommee <= 1000))
        && (!('rapport' in d) || d.rapport == null || d.rapport is map);
    }
    match /quetes/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validQuest(request.resource.data);
      // Le joueur désigné peut proposer le rapport de mission d'une quête en cours ou terminée.
      allow update: if realAccount()
        && resource.data.statut in ['encours', 'terminee']
        && resource.data.redacteur == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rapportBrouillon', 'majLe'])
        && request.resource.data.rapportBrouillon is map
        && request.resource.data.rapportBrouillon.resume is string
        && request.resource.data.rapportBrouillon.resume.size() <= 4000;
      // Un membre confirmé du groupe peut désigner le rédacteur du rapport parmi les membres confirmés.
      allow update: if realAccount()
        && resource.data.statut in ['encours', 'terminee']
        && get(/databases/$(database)/documents/inscriptions/$(id + '__' + request.auth.uid)).data.statut == 'confirmee'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redacteur', 'majLe'])
        && request.resource.data.redacteur is string
        && get(/databases/$(database)/documents/inscriptions/$(id + '__' + request.resource.data.redacteur)).data.statut == 'confirmee';
      allow delete: if isAdmin();
    }

    // ---------- Inscriptions (séparées des quêtes) ----------
    // ID d'une demande de joueur : <idQuête>__<uid>  => une seule demande par joueur et par quête.
    // ID d'un participant ajouté par le DM : <idQuête>__dm-<aléatoire>
    function validSignup(d) {
      return d.keys().hasOnly(['quete', 'uid', 'aventurier', 'nom', 'statut', 'creeLe', 'majLe'])
        && d.keys().hasAll(['quete', 'uid', 'nom', 'statut'])
        && str(d.quete, 1, 60) && str(d.uid, 1, 128) && str(d.nom, 1, 40)
        && d.statut in ['attente', 'confirmee', 'refusee'];
    }
    match /inscriptions/{id} {
      allow read: if true;

      // Joueur connecté (compte Google) : sa propre demande, avec un de SES personnages, en attente, sur une quête ouverte.
      allow create: if realAccount()
        && 'aventurier' in request.resource.data
        && get(/databases/$(database)/documents/aventuriers/$(request.resource.data.aventurier)).data.proprietaire == request.auth.uid
        && validSignup(request.resource.data)
        && id == request.resource.data.quete + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.statut == 'attente'
        && request.resource.data.creeLe == request.time
        && exists(/databases/$(database)/documents/quetes/$(request.resource.data.quete))
        && get(/databases/$(database)/documents/quetes/$(request.resource.data.quete)).data.statut == 'ouverte';

      // Admin : peut ajouter un participant, confirmer, refuser, corriger un nom.
      allow create: if isAdmin() && validSignup(request.resource.data);
      allow update: if isAdmin() && validSignup(request.resource.data)
        && request.resource.data.quete == resource.data.quete
        && request.resource.data.uid == resource.data.uid;

      // Le joueur peut retirer sa propre demande tant que la quête est ouverte (pas une demande non retenue) ;
      // une fois le groupe confirmé, seul le DM peut retirer quelqu'un.
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.statut != 'refusee'
            && get(/databases/$(database)/documents/quetes/$(resource.data.quete)).data.statut == 'ouverte');
    }

    // ---------- Compendium public ----------
    // Tout joueur connecté propose une entrée ou une modification ; elle est publiée quand
    // deux AUTRES joueurs l'ont approuvée (ou par le DM). Le DM peut masquer, rejeter ou supprimer.
    function compFieldsOk(d) {
      return str(d.titre, 1, 100) && str(d.categorie, 1, 40) && str(d.region, 1, 40)
        && d.get('contenu', '') is string && d.get('contenu', '').size() <= 20000
        && d.get('image', '') is string && d.get('image', '').size() <= 400000
        && d.get('quete', '') is string && d.get('quete', '').size() <= 60;
    }
    function byMe(m) {
      return m is map && m.keys().hasOnly(['uid', 'nom']) && m.uid == request.auth.uid && str(m.nom, 1, 60);
    }
    function validProp(p) {
      return p is map && p.keys().hasOnly(['titre', 'categorie', 'region', 'contenu', 'image', 'quete', 'par', 'approbations', 'date'])
        && compFieldsOk(p) && p.approbations is map && p.par is map;
    }
    function validComp(d) {
      return d.keys().hasOnly(['titre', 'categorie', 'region', 'contenu', 'image', 'quete', 'masque', 'publiee', 'proposition',
                               'creePar', 'modifiePar', 'creeLe', 'majLe'])
        && compFieldsOk(d) && d.masque is bool && d.publiee is bool
        && (d.get('proposition', null) == null || validProp(d.proposition));
    }
    function sameAsProp(n, p) {
      return n.titre == p.titre && n.categorie == p.categorie && n.region == p.region
        && n.get('contenu', '') == p.get('contenu', '') && n.get('image', '') == p.get('image', '')
        && n.get('quete', '') == p.get('quete', '');
    }
    match /compendium/{id} {
      allow read: if resource.data.masque == false || isAdmin();
      allow create, update: if isAdmin() && validComp(request.resource.data);
      allow delete: if isAdmin();

      // Nouvelle entrée proposée par un joueur (non publiée, zéro approbation).
      allow create: if realAccount() && validComp(request.resource.data)
        && request.resource.data.masque == false && request.resource.data.publiee == false
        && byMe(request.resource.data.creePar)
        && validProp(request.resource.data.proposition)
        && byMe(request.resource.data.proposition.par)
        && request.resource.data.proposition.approbations.size() == 0
        && sameAsProp(request.resource.data, request.resource.data.proposition);

      // Proposer (ou remplacer) une modification : les approbations repartent à zéro.
      allow update: if realAccount() && resource.data.masque == false && validComp(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposition'])
        && validProp(request.resource.data.proposition)
        && byMe(request.resource.data.proposition.par)
        && request.resource.data.proposition.approbations.size() == 0;

      // Approuver (1re approbation) : on ajoute seulement son propre nom.
      allow update: if realAccount() && resource.data.masque == false
        && resource.data.get('proposition', null) != null
        && resource.data.proposition.par.uid != request.auth.uid
        && !(request.auth.uid in resource.data.proposition.approbations)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['proposition'])
        && request.resource.data.proposition.diff(resource.data.proposition).affectedKeys().hasOnly(['approbations'])
        && request.resource.data.proposition.approbations.diff(resource.data.proposition.approbations).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.proposition.approbations[request.auth.uid] is string
        && request.resource.data.proposition.approbations.size() == 1;

      // 2e approbation : publie exactement le contenu proposé.
      allow update: if realAccount() && resource.data.masque == false && validComp(request.resource.data)
        && resource.data.get('proposition', null) != null
        && resource.data.proposition.par.uid != request.auth.uid
        && !(request.auth.uid in resource.data.proposition.approbations)
        && resource.data.proposition.approbations.size() == 1
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['titre', 'categorie', 'region', 'contenu', 'image', 'quete', 'publiee', 'proposition', 'modifiePar', 'majLe'])
        && sameAsProp(request.resource.data, resource.data.proposition)
        && request.resource.data.publiee == true
        && request.resource.data.proposition == null
        && request.resource.data.modifiePar == resource.data.proposition.par;

      // Historique : chaque version publiée note son auteur et ses approbateurs. Jamais modifié.
      match /versions/{vid} {
        allow read: if isAdmin() || get(/databases/$(database)/documents/compendium/$(id)).data.masque == false;
        allow create: if isAdmin()
          || (realAccount()
            && request.resource.data.keys().hasOnly(['titre', 'categorie', 'region', 'contenu', 'image', 'quete', 'par', 'approbateurs', 'date'])
            && compFieldsOk(request.resource.data)
            && request.resource.data.approbateurs is map
            && request.resource.data.approbateurs.size() == 2
            && request.auth.uid in request.resource.data.approbateurs
            && getAfter(/databases/$(database)/documents/compendium/$(id)).data.publiee == true
            && getAfter(/databases/$(database)/documents/compendium/$(id)).data.get('proposition', null) == null
            && get(/databases/$(database)/documents/compendium/$(id)).data.proposition.approbations.size() == 1
            && request.resource.data.approbateurs.keys().hasAll(get(/databases/$(database)/documents/compendium/$(id)).data.proposition.approbations.keys())
            && request.resource.data.par == get(/databases/$(database)/documents/compendium/$(id)).data.proposition.par
            && sameAsProp(request.resource.data, get(/databases/$(database)/documents/compendium/$(id)).data.proposition));
        allow delete: if isAdmin();
      }
    }

    // ---------- Planification (facultative) : dates proposées et disponibilités ----------
    function validPlan(d) {
      return d.keys().hasOnly(['quete', 'date', 'heure', 'par', 'dispo', 'dm', 'creeLe'])
        && str(d.quete, 1, 60) && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && optStr(d, 'heure', 30) && d.dispo is map && d.par is map
        && (!('dm' in d) || d.dm in ['oui', 'peut', 'non']);
    }
    // Inscrit (non refusé) à une quête encore ouverte
    function planner(q) {
      return realAccount()
        && exists(/databases/$(database)/documents/inscriptions/$(q + '__' + request.auth.uid))
        && get(/databases/$(database)/documents/inscriptions/$(q + '__' + request.auth.uid)).data.statut != 'refusee'
        && get(/databases/$(database)/documents/quetes/$(q)).data.statut == 'ouverte';
    }
    function myDispoOk(d) {
      return !(request.auth.uid in d.dispo) || d.dispo[request.auth.uid] in ['oui', 'peut', 'non'];
    }
    match /planif/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPlan(request.resource.data);
      allow create: if validPlan(request.resource.data) && planner(request.resource.data.quete)
        && byMe(request.resource.data.par) && !('dm' in request.resource.data)
        && request.resource.data.dispo.keys().hasOnly([request.auth.uid]) && myDispoOk(request.resource.data);
      allow update: if validPlan(request.resource.data) && planner(resource.data.quete)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dispo'])
        && request.resource.data.dispo.diff(resource.data.dispo).affectedKeys().hasOnly([request.auth.uid])
        && myDispoOk(request.resource.data);
      allow delete: if isAdmin() || (planner(resource.data.quete) && resource.data.par.uid == request.auth.uid);
    }

    // ---------- Le Crieur de la Sword Coast (nouvelles publiques, écrites par le DM) ----------
    match /nouvelles/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['titre', 'contenu', 'region', 'aventuriers', 'quete', 'date'])
        && str(request.resource.data.titre, 1, 120)
        && optStr(request.resource.data, 'contenu', 5000)
        && (!('aventuriers' in request.resource.data) || request.resource.data.aventuriers is list);
      allow delete: if isAdmin();
    }
    // ---------- Espace DM : notes secrètes et journal des évolutions (DM seulement) ----------
    match /notesdm/{id} {
      allow read, write: if isAdmin();
    }
    match /evolutions/{id} {
      allow read, write: if isAdmin();
    }
    // ---------- Manuel du DM : dossiers des personnages (Don, notes…), PNJ, bestiaire, rencontres, scénarios ----------
    match /dossiers/{id} {
      allow read, write: if isAdmin();
    }
    match /pnj/{id} {
      allow read, write: if isAdmin();
    }
    match /factions/{id} {
      allow read, write: if isAdmin();
    }
    match /parties/{id} {
      allow read, write: if isAdmin();
    }
    match /modules/{id} {
      allow read, write: if isAdmin();
    }
    match /butins/{id} {
      allow read, write: if isAdmin();
    }
    match /relations/{id} {
      allow read, write: if isAdmin();
    }
    match /monstres/{id} {
      allow read, write: if isAdmin();
    }
    match /rencontres/{id} {
      allow read, write: if isAdmin();
    }
    match /scenarios/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- Wiki des règles maison (lecture publique, écriture admin) ----------
    match /wiki/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['titre', 'contenu', 'ordre', 'creeLe', 'majLe'])
        && str(request.resource.data.titre, 1, 100)
        && str(request.resource.data.contenu, 0, 50000)
        && (!('ordre' in request.resource.data) || request.resource.data.ordre is number);
      allow delete: if isAdmin();
    }

    // ---------- Phase 2 : renommée (lecture publique, écriture admin) ----------
    function validAdv(d) {
      return d.keys().hasOnly(['nom', 'joueur', 'niveaux', 'proprietaire', 'espece', 'classe', 'description',
                               'background', 'image', 'don', 'pnj', 'rangGuilde', 'etoiles', 'creeLe', 'majLe'])
        && str(d.nom, 1, 60)
        && optStr(d, 'joueur', 60) && optStr(d, 'espece', 60) && optStr(d, 'classe', 60)
        && optStr(d, 'description', 2000) && optStr(d, 'background', 4000) && optStr(d, 'don', 500)
        && optStr(d, 'image', 400000)
        && (!('pnj' in d) || d.pnj is bool)
        && (!('rangGuilde' in d) || d.rangGuilde in ['bois', 'cuivre', 'fer', 'argent', 'or', 'mithral', 'rose'])
        && (!('etoiles' in d) || (d.etoiles is int && d.etoiles >= 0 && d.etoiles <= 3))
        && (!('niveaux' in d) || d.niveaux is map);
    }
    match /aventuriers/{id} {
      allow read: if true;
      // Fiche : DM pour tout ; un joueur crée et modifie seulement ses propres fiches (jamais les rangs ni le Don).
      allow create, update: if isAdmin() && validAdv(request.resource.data);
      allow create: if realAccount() && validAdv(request.resource.data)
        && request.resource.data.proprietaire == request.auth.uid
        && !('niveaux' in request.resource.data) && !('don' in request.resource.data)
        && !('pnj' in request.resource.data)
        && !('rangGuilde' in request.resource.data) && !('etoiles' in request.resource.data);
      allow update: if realAccount() && validAdv(request.resource.data)
        && resource.data.proprietaire == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nom', 'espece', 'classe', 'description', 'background', 'image', 'majLe']);
      allow delete: if isAdmin();
    }
    // Points de renommée : réservés au DM (les joueurs ne voient que les rangs)
    match /points/{id} {
      allow read, write: if isAdmin();
    }
    match /prive/{id} {
      allow read, write: if isAdmin();
    }
    // Historique public des changements de rang
    match /rangs/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['aventurier', 'nom', 'bureau', 'ancien', 'nouveau', 'date'])
        && request.resource.data.ancien is int && request.resource.data.nouveau is int;
      allow delete: if isAdmin();
    }
    // Journal des points : réservé au DM
    match /journal/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['aventurier', 'nom', 'bureau', 'points', 'notoriete', 'raison', 'quete', 'date'])
        && request.resource.data.points is int
        && str(request.resource.data.aventurier, 1, 80);
      allow delete: if isAdmin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
